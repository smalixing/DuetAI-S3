menu "JoyInside Cloud Voice Call"

    config JOYINSIDE_URI
        string "JoyInside WebSocket endpoint URI"
        default "wss://joyinside.jd.com/soulmate/voiceCall/v4"
        help
            WebSocket endpoint for the JD JoyInside voice-call service.

    config JOYINSIDE_ACCESS_KEY_ID
        string "Access key id"
        default ""
        help
            Application access key id issued by the JoyInside platform.

    config JOYINSIDE_ACCESS_KEY_SECRET
        string "Access key secret"
        default ""
        help
            Application access key secret used to sign auth parameters.

    config JOYINSIDE_BOT_ID
        string "Bot id"
        default ""
        help
            Robot / bot identifier bound to this device.

    config JOYINSIDE_DEVICE_TOKEN
        string "Device token"
        default ""
        help
            Device token used as the HMAC key for the device JWT.

    config JOYINSIDE_DEVICE_ID
        string "Device id (did)"
        default ""
        help
            Device id (did) reported to the platform.

endmenu
